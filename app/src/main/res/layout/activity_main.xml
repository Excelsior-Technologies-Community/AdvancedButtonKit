<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:padding="16dp"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Advanced Button Library Demo"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ToggleButton Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Toggle Button"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Click to toggle ON/OFF"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <com.ext.advanced_button_types.ToggleButton
            android:id="@+id/toggleButton"
            android:layout_width="150dp"
            android:layout_height="50dp"
            app:toggle_isToggled="false"
            app:toggle_thumbColor="@android:color/white"
            app:toggle_toggledBackgroundColor="@android:color/holo_green_dark"
            app:toggle_untoggledBackgroundColor="@android:color/holo_red_dark" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/darker_gray" />

        <!-- GradientButton Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Gradient Button"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Horizontal gradient effect"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <com.ext.advanced_button_types.GradientButton
            android:id="@+id/gradientButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Horizontal Gradient"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:gradient_cornerRadius="24dp"
            app:gradient_endColor="@android:color/holo_purple"
            app:gradient_orientation="leftRight"
            app:gradient_startColor="@android:color/holo_blue_dark" />

        <com.ext.advanced_button_types.GradientButton
            android:id="@+id/gradientButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:text="Vertical Gradient"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:gradient_cornerRadius="16dp"
            app:gradient_endColor="@android:color/holo_red_dark"
            app:gradient_orientation="topBottom"
            app:gradient_startColor="@android:color/holo_orange_light" />

        <com.ext.advanced_button_types.GradientButton
            android:id="@+id/gradientButton3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:text="Diagonal Gradient"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:gradient_cornerRadius="32dp"
            app:gradient_endColor="@android:color/holo_blue_light"
            app:gradient_orientation="tlBr"
            app:gradient_startColor="@android:color/holo_green_dark" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/darker_gray" />

        <!-- LoadingButton Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Loading Button"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Simulates async operation with progress bar"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <com.ext.advanced_button_types.LoadingButton
            android:id="@+id/loadingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:padding="10dp"
            android:text="Start Loading"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:loading_progressBarColor="@android:color/white"
            app:loading_progressBarSize="40dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/darker_gray" />

        <!-- RippleEffectButton Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Ripple Effect Button"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Custom ripple animation"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <com.ext.advanced_button_types.RippleEffectButton
            android:id="@+id/rippleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/holo_purple"
            android:padding="16dp"
            android:text="Click for Ripple Effect"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:ripple_alpha="100"
            app:ripple_color="@android:color/white"
            app:ripple_duration="600" />

        <TextView
            android:id="@+id/rippleClickCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clicks: 0"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>